# Optional OpenAI-compatible model used for summaries and state evaluation.
OMBRE_API_KEY=

# Replace both values before starting. Do not commit the resulting .env file.
OMBRE_RESPONSE_SEAL=CHANGE_ME_TO_A_RANDOM_PRIVATE_SEAL
CLIO_MANAGER_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Optional Bark push integration. Leave empty to disable real push delivery.
OMBRE_BARK_BASE_URL=https://api.day.app
OMBRE_BARK_DEVICE_KEY=

# Portable local storage. Absolute paths also work.
CLIO_DATA_DIR=./data
CLIO_MODEL_DIR=./models
CLIO_EXPORT_DIR=./exports

# Optional nursery module. Generate both secret values locally; never commit them.
# OMBRE_NURSERY_INTERNAL_TOKEN must contain at least 32 random characters and
# must be identical in the Brain and Manager environments.
OMBRE_NURSERY_INTERNAL_TOKEN=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_TOKEN
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OMBRE_NURSERY_VAULT_KEY=CHANGE_ME_TO_A_VALID_FERNET_KEY
OMBRE_NURSERY_RULES_PATH=./nursery/capability-rules-v1.yaml
OMBRE_NURSERY_DB=./data/nursery.sqlite3
OMBRE_NURSERY_VAULT_DIR=./data/nursery-secrets
OMBRE_BRAIN_INTERNAL_URL=http://ombre-brain:8000

