# Optional OpenAI-compatible model used for summaries and state evaluation.
OMBRE_API_KEY=

# Replace both values before starting. Do not commit the resulting .env file.
OMBRE_RESPONSE_SEAL=CHANGE_ME_TO_A_RANDOM_PRIVATE_SEAL
CLIO_MANAGER_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Optional Bark push integration. Leave empty to disable real push delivery.
OMBRE_BARK_BASE_URL=https://api.day.app
OMBRE_BARK_DEVICE_KEY=

# Portable local storage. Absolute paths also work.
CLIO_DATA_DIR=./data
CLIO_MODEL_DIR=./models
CLIO_EXPORT_DIR=./exports

