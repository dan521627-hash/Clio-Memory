ARG CLIO_BASE_IMAGE=clio-memory:latest
FROM ${CLIO_BASE_IMAGE}

RUN pip install --no-cache-dir \
    "fastapi>=0.115.0,<1.0.0" \
    "uvicorn>=0.34.0,<1.0.0" \
    "pyzipper>=0.3.6,<1.0.0"

COPY *.py /app/
COPY manager/ /app/manager/

EXPOSE 8787

CMD ["uvicorn", "manager_server:app", "--host", "0.0.0.0", "--port", "8787"]
